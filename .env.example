# Required core runtime
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ALL=false
CORS_ORIGINS=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jobdesk365
DB_SSL=false
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d

# Required AI provider selection
AI_PROVIDER=huggingface

# If AI_PROVIDER=openai, set all 3:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# If AI_PROVIDER=huggingface, set all 3:
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Optional Outlook OAuth (set all or leave all empty)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=
MS_SCOPES=

# Optional Supabase (set all or leave all empty)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_AVATAR_BUCKET=

# Optional NOWPayments (set all or leave all empty)
NOWPAYMENTS_API_KEY=
NOWPAYMENT_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=
NOWPAYMENTS_PAY_CURRENCY=
NOWPAYMENTS_SUCCESS_URL=
NOWPAYMENTS_CANCEL_URL=
NOWPAYMENTS_IPN_CALLBACK_URL=
NOWPAYMENTS_TOPUP_MIN=
NOWPAYMENTS_TOPUP_MAX=
